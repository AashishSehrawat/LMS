# Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_URI=http://localhost:5173
SERVER_URI=http://localhost:3000

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/LMS?retryWrites=true&w=majority&family=4
DB_NAME=LMS

# Authentication & Sessions
SESSION_SECRET=your_session_secret_key
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_key

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Email (Nodemailer for OTP & notifications)
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password

# Cloudinary (Media / Course thumbnails & lectures)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay (Payments)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Google Gemini AI (Smart Course Search)
GEMINI_API_KEY=your_gemini_api_key
